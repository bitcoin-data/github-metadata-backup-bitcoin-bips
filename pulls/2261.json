      "subscriptions_url": "https://api.github.com/users/SatsAndSports/subscriptions",
      "organizations_url": "https://api.github.com/users/SatsAndSports/orgs",
      "repos_url": "https://api.github.com/users/SatsAndSports/repos",
      "events_url": "https://api.github.com/users/SatsAndSports/events%7B/privacy%7D",
      "received_events_url": "https://api.github.com/users/SatsAndSports/received_events",
