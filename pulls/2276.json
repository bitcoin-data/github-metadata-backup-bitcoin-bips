      "html_url": "https://github.com/bitsagarob",
      "followers_url": "https://api.github.com/users/bitsagarob/followers",
      "following_url": "https://api.github.com/users/bitsagarob/following%7B/other_user%7D",
      "gists_url": "https://api.github.com/users/bitsagarob/gists%7B/gist_id%7D",
