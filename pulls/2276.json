    "title": "BIP376: keep PSBT_IN_WITNESS_UTXO after finalization",
    "user": {
      "login": "bitsagarob",
      "id": 17001979,
      "node_id": "MDQ6VXNlcjE3MDAxOTc5",
      "avatar_url": "https://avatars.githubusercontent.com/u/17001979?v=4",
