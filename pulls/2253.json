    "title": "BIP375: correctly detect SegWit v2+ witness programs",
    "user": {
      "login": "questfever",
      "id": 230836337,
      "node_id": "U_kgDODcJIcQ",
      "avatar_url": "https://avatars.githubusercontent.com/u/230836337?v=4",
      "gravatar_id": "",
      "url": "https://api.github.com/users/questfever",
      "html_url": "https://github.com/questfever",
      "followers_url": "https://api.github.com/users/questfever/followers",
      "following_url": "https://api.github.com/users/questfever/following%7B/other_user%7D",
      "gists_url": "https://api.github.com/users/questfever/gists%7B/gist_id%7D",
      "starred_url": "https://api.github.com/users/questfever/starred%7B/owner%7D%7B/repo%7D",
      "subscriptions_url": "https://api.github.com/users/questfever/subscriptions",
      "organizations_url": "https://api.github.com/users/questfever/orgs",
      "repos_url": "https://api.github.com/users/questfever/repos",
      "events_url": "https://api.github.com/users/questfever/events%7B/privacy%7D",
      "received_events_url": "https://api.github.com/users/questfever/received_events",
      "type": "User",
