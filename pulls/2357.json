    "title": "script: count UTF-8 characters when validating BIP titles",
    "user": {
      "login": "unixglo",
      "id": 260032869,
      "node_id": "U_kgDOD3_JZQ",
      "avatar_url": "https://avatars.githubusercontent.com/u/260032869?v=4",
      "gravatar_id": "",
      "url": "https://api.github.com/users/unixglo",
      "html_url": "https://github.com/unixglo",
      "followers_url": "https://api.github.com/users/unixglo/followers",
      "following_url": "https://api.github.com/users/unixglo/following%7B/other_user%7D",
      "gists_url": "https://api.github.com/users/unixglo/gists%7B/gist_id%7D",
      "starred_url": "https://api.github.com/users/unixglo/starred%7B/owner%7D%7B/repo%7D",
      "subscriptions_url": "https://api.github.com/users/unixglo/subscriptions",
      "organizations_url": "https://api.github.com/users/unixglo/orgs",
      "repos_url": "https://api.github.com/users/unixglo/repos",
      "events_url": "https://api.github.com/users/unixglo/events%7B/privacy%7D",
