    "title": "BIP352: clarify input-sum accumulation — tolerate intermediate point at infinity",
    "user": {
      "login": "SatsAndSports",
      "id": 236271455,
      "node_id": "U_kgDODhU3Xw",
      "avatar_url": "https://avatars.githubusercontent.com/u/236271455?v=4",
